# Supabase (Auth + projet)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Réservé au serveur — ne jamais exposer au client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL Supabase (pooler transaction mode, asyncpg)
# postgresql+asyncpg://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://user:password@host:6543/postgres

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
